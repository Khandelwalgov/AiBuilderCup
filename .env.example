ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://opportunity:local-development-only@localhost:5432/opportunity
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
FIREBASE_PROJECT_ID=
# Local protected endpoints also require Application Default Credentials.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/repo/credentials.json

# Server-only Gemini key. Never use a VITE_ variable for this secret.
AI_EXTRACTION_PROVIDER=gemini
# All external inference defaults to a zero budget, including development smoke commands.
# A paid worker requires separate authorization, reviewed price ceilings and durable reservations.
PROCESS_ROLE=api
PAID_AI_WORKER_ENABLED=false
AI_GLOBAL_BUDGET_USD=0
AI_RUN_BUDGET_USD=0
AI_MAX_REQUESTS_PER_RUN=4
AI_DAILY_CALL_LIMIT=10
AI_MONTHLY_CALL_LIMIT=100
AI_PRICE_CEILINGS={}
NEURAL_RETRIEVAL_ENABLED=true
# Container bundles checksum-pinned public CPU weights at this path.
# For local testing, download weights with retrieval.model_artifact and set a local directory.
NEURAL_MODEL_DIRECTORY=/app/models/multilingual-minilm
# Explicit development alternative; never a VITE_ variable, never automatic fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_TIMEOUT_SECONDS=180
OPENAI_MAX_INPUT_TOKENS=160000
OPENAI_MAX_OUTPUT_TOKENS=16384
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=120
GEMINI_MAX_INPUT_TOKENS=200000
GEMINI_MAX_OUTPUT_TOKENS=16384
# Opt in locally; public catalogue remains reviewed real records only.
ENABLE_DEVELOPMENT_CATALOGUE=false
INGESTION_MIN_INTERVAL_SECONDS=30

# Optional Gemini intent interpretation; false avoids model calls. Local cited explanations work.
AI_ASSISTANT_LIVE_ENABLED=false

# HTTP ingestion needs explicit operator authorization; budget is informational, not a cap.
AI_INGESTION_LIVE_ENABLED=false
# AI_INGESTION_TEST_BUDGET_USD=1.00

# Private document vault: enable only for fictional local development files.
# Production uploads stay disabled until malware scanning/security acceptance.
DOCUMENT_UPLOADS_ENABLED=false
DOCUMENT_STORAGE_BACKEND=local
DOCUMENT_LOCAL_ROOT=.private-documents
DOCUMENT_MAX_FILE_BYTES=5242880
DOCUMENT_MAX_COUNT=25
DOCUMENT_MAX_TOTAL_BYTES=52428800
DOCUMENT_GCS_BUCKET=
DOCUMENT_SIGNING_KEY=

# Maximum subject–opportunity pairs assessed by hybrid retrieval (50–500).
RETRIEVAL_SHORTLIST_SIZE=150

# Local PostgreSQL by default; deployment supplies neon plus an SSL Secret Manager URL.
DATABASE_PROVIDER=postgresql
