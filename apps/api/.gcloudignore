# Build context allowlist; never upload local data or credentials.
**
!Dockerfile
!pyproject.toml
!cloudbuild.yaml
!uv.lock
!alembic.ini
!.dockerignore
!.gcloudignore
!src/
!src/**
!alembic/
!alembic/**
**/__pycache__/**
**/*.pyc
**/.*
**/*credentials*.json
**/*service-account*.json
**/*.pem
**/*.key
