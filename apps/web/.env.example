VITE_APP_NAME=Unclaimed
# Leave blank in local development to use Vite's API proxy.
VITE_API_BASE_URL=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Show the explicit synthetic-development catalogue switch (backend must also opt in).
VITE_ENABLE_DEVELOPMENT_CATALOGUE=false
# Local shell-only proxy override (not bundled): API_PROXY_TARGET=http://127.0.0.1:8000 pnpm dev
# Playwright automatically starts dedicated listeners on web5174/API8001.
